# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 【上架前必改】将下方本机地址换成正式 HTTPS 域名（勿提交真实密钥到文档）
# 例：VITE_SERVER_BASEURL = 'https://api.example.com/jeecg-boot'
VITE_SERVER_BASEURL = 'http://127.0.0.1:8080/jeecg-boot'
VITE_UPLOAD_BASEURL = 'http://127.0.0.1:8080/jeecg-boot'

# 微信分环境：develop/trial 可继续本机；RELEASE 上架前必须改为合法域名
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:8080/jeecg-boot'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://127.0.0.1:8080/jeecg-boot'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://127.0.0.1:8080/jeecg-boot'
VITE_UPLOAD_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:8080/jeecg-boot'
VITE_UPLOAD_BASEURL__WEIXIN_TRIAL = 'http://127.0.0.1:8080/jeecg-boot'
VITE_UPLOAD_BASEURL__WEIXIN_RELEASE = 'http://127.0.0.1:8080/jeecg-boot'
# 同步检查：manifest.config.ts → mp-weixin.setting.urlCheck=true；开启 __usePrivacyCheck__
