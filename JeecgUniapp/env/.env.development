# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = true

# 电脑浏览器 / H5 可用 localhost；Android 真机不能访问手机自己的 127.0.0.1
VITE_SERVER_BASEURL = 'http://localhost:8080/jeecg-boot'
VITE_UPLOAD_BASEURL = 'http://localhost:8080/jeecg-boot'
# Android 运行/发行：走公网入口（HBuilderX「运行」读本文件，不是 .env.production）
VITE_SERVER_BASEURL_APP = 'http://116.62.115.226/jeecg-boot'
VITE_UPLOAD_BASEURL_APP = 'http://116.62.115.226/jeecg-boot'
