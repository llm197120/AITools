<?xml version="1.0" encoding="utf-8"?>
<!-- 备案前内测走公网 HTTP；上 HTTPS 后改为 cleartextTrafficPermitted="false" 并重打 APK -->
<network-security-config>
	<base-config cleartextTrafficPermitted="true">
		<trust-anchors>
			<certificates src="system" />
		</trust-anchors>
	</base-config>
</network-security-config>
