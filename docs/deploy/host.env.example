# 复制为 host.env 后填写。本文件可提交；host.env 勿提交。
# 开发机 → 长期跑服务的那台 Windows（局域网 SSH）。

# 服务主机地址（必填）。同一局域网填路由器分配的 IP；
# 人在外时改填 Tailscale 的 100.x.x.x（见 service-host-remote-control.md）。
HOST_IP=192.168.1.50

# OpenSSH 登录
SSH_USER=57089
SSH_PORT=22
# 私钥路径。留空则尝试 %USERPROFILE%\.ssh\id_ed25519
SSH_IDENTITY=

# 主机上的仓库目录（建议 git clone 到这里）
REMOTE_REPO=C:\homeai\src\AITools
GIT_REMOTE=origin
GIT_BRANCH=dev

# 检查时额外打公网入口（可留空则用 config.env 的 PUBLIC_BASE）
PUBLIC_BASE=https://liulm.top
