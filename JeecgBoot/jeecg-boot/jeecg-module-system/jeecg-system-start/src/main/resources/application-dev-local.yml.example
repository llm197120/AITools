# 本地 OSS 配置示例（复制为 application-dev-local.yml 并填写真实值）

jeecg:
  uploadType: alioss
  oss:
    accessKey: 你的AccessKeyId
    secretKey: 你的AccessKeySecret
    endpoint: oss-cn-beijing.aliyuncs.com
    bucketName: llmaitools
    # 可选：绑定自定义 CDN 域名时使用；未配置则使用 bucket 默认域名
    staticDomain: https://llmaitools.oss-cn-beijing.aliyuncs.com
