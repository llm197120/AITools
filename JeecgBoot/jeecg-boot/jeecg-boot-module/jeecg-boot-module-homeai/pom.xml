<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jeecgframework.boot3</groupId>
        <artifactId>jeecg-boot-module</artifactId>
        <version>3.9.3</version>
    </parent>

    <artifactId>jeecg-boot-module-homeai</artifactId>

    <dependencies>
        <!-- 系统核心模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-system-biz</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>

        <!-- 单体模式不要引入 jeecg-boot-starter-cloud：会传递 nacos-config，触发 spring.config.import=nacos 启动校验。OSS 走 base-core OssBootUtil 即可。 -->

        <!-- AI 编排能力（LangChain4j + LiteFlow） -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-boot-starter-ai</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>

        <!-- AI RAG 知识库 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-boot-module-airag</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>

        <!-- poi-tl 模板引擎（AI 文档生成） -->
        <dependency>
            <groupId>com.deepoove</groupId>
            <artifactId>poi-tl</artifactId>
            <version>1.12.2</version>
        </dependency>

        <!-- update-begin author:admin date:2026-08-12 for:【HomeAI-R22】PDF 首帧缩略图 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- update-end author:admin date:2026-08-12 for:【HomeAI-R22】PDF 首帧缩略图 -->
    </dependencies>

    <!-- 父 POM 默认 skipTests=true；本模块纯逻辑单测在 test 阶段执行 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
