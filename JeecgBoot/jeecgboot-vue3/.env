# port
VITE_PORT = 3100

#  网站标题
VITE_GLOB_APP_TITLE = 家庭AI小工具

# 简称，此变量只能是字符/下划线（用作本地缓存前缀，界面短标题用上面的网站标题）
VITE_GLOB_APP_SHORT_NAME = HomeAI_Tools

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=http://cas.test.com:8443/cas

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = false

# 开启微前端模式（本项目非 qiankun 微前端，保持 false；docs/design 未使用乾坤）
VITE_GLOB_APP_OPEN_QIANKUN=false

# 文件预览地址
VITE_GLOB_ONLINE_VIEW_URL=http://fileview.jeecg.com/onlinePreview


