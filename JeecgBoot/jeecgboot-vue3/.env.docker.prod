# 是否启用mock
VITE_USE_MOCK = false

# 发布路径
VITE_PUBLIC_PATH = /

VITE_BUILD_COMPRESS = 'gzip'
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# FRP / 公网 Nginx 同域反代，必须用相对路径。写成 127.0.0.1 会导致外网浏览器打到访客本机。
VITE_GLOB_API_URL=/jeecg-boot

# 上传/预览等与 API 同域
VITE_GLOB_DOMAIN_URL=/jeecg-boot

VITE_GLOB_API_URL_PREFIX=

VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# 备案（构建进 _app.config.js）
VITE_GLOB_SITE_DOMAIN=liulm.top
VITE_GLOB_ICP_NUMBER=豫ICP备2026044697号-1
VITE_GLOB_ICP_QUERY_URL=https://beian.miit.gov.cn/
