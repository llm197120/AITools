# HomeAI 运行时配置（复制为 .env.homeai，勿提交仓库）
# Spring Boot 可通过环境变量覆盖 application-docker.yml

# 示例：覆盖数据库（若与 compose 默认服务名不一致时使用）
# SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_URL=jdbc:mysql://homeai-mysql:3306/jeecg-boot?...
# SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_USERNAME=root
# SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_PASSWORD=与 MYSQL_ROOT_PASSWORD 一致

# HomeAI 必填（生产请使用强随机值）
# HOMEAI_AI_KEY_ENCRYPTION_KEY=
# HOMEAI_JWT_SECRET=
# HOMEAI_WECHAT_APPID=
# HOMEAI_WECHAT_SECRET=

# OSS（若使用阿里云 OSS）
# JEECG_UPLOADTYPE=alioss
