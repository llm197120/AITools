# 复制为 .env（勿提交仓库）
ACR_REGISTRY=crpi-1is06jvzttfocl45.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=liulm
IMAGE_TAG=prd-latest

# 后端映射到本机端口，供宿主机 Nginx 反代 /jeecgboot（生产 8080，开发 8081）
BACKEND_HTTP_PORT=8080

# 静态文件目录（deploy-static.sh 使用）
WEB_ROOT=/var/www/homeai-admin
WEB_ROOT_DEV=/var/www/homeai-admin-dev

ACR_USERNAME=
ACR_PASSWORD=

MYSQL_ROOT_PASSWORD=root
